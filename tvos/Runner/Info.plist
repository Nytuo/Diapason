<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleDisplayName</key>
  <string>Diapason</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>diapason</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$(FLUTTER_BUILD_NAME)</string>
  <key>CFBundleVersion</key>
  <string>$(FLUTTER_BUILD_NUMBER)</string>
  <!--
    flutter-tvos copies `flutter_assets` to the app bundle root, but the
    prebuilt tvOS device engine's `+[FlutterDartProject lookupKeyForAsset:]`
    otherwise defaults to the iOS `Frameworks/App.framework/flutter_assets`
    path. Without this override every plugin that resolves a bundled asset
    via `lookupKeyForAsset:` (e.g. `VideoPlayerController.asset`) gets a
    path that does not exist on a physical device. `FLTAssetsPath` points
    the engine at the directory the build actually produces.
  -->
  <!-- Diapason Connect finds other Diapason devices with Bonjour, which tvOS treats as local network access. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Diapason looks for your other devices on the network so you can play on them and control them.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_diapason-connect._tcp</string>
    <!-- Debug and profile builds publish the Dart VM service here, for hot reload and DevTools. -->
    <string>_dartVmService._tcp</string>
  </array>
  <key>FLTAssetsPath</key>
  <string>flutter_assets</string>
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
          <key>UISceneClassName</key>
          <string>UIWindowScene</string>
          <key>UISceneConfigurationName</key>
          <string>flutter</string>
          <key>UISceneDelegateClassName</key>
          <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
          <key>UISceneStoryboardFile</key>
          <string>Main</string>
        </dict>
      </array>
    </dict>
  </dict>
  <key>UIMainStoryboardFile</key>
  <string>Main</string>
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
  </array>
</dict>
</plist>
