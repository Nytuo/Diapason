# Flutter tvOS Podfile — auto-generated by flutter-tvos create, then hand-adapted
# for Diapason (see tvos/scripts/restore_tvos_plugins.py).

platform :tvos, '17.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

target 'Runner' do
  use_frameworks!

  # The flutter tool rewrites .flutter-plugins-dependencies without a tvos key
  # on every `flutter pub get`/`analyze`/`build`, and installing straight from
  # it in that state drops every tvOS plugin from the Runner without a word.
  # shared_preferences is one of them, so a build that ships that way cannot
  # keep a signed-in session. Put the key back first and refuse to install if
  # it is still not there.
  restore_tvos_plugins = File.expand_path(
    File.join('scripts', 'restore_tvos_plugins.py'), File.dirname(__FILE__))
  system('python3', restore_tvos_plugins) if File.exist?(restore_tvos_plugins)

  # Install plugin pods from .flutter-plugins-dependencies
  flutter_plugins_deps = File.expand_path(File.join('..', '.flutter-plugins-dependencies'), File.dirname(__FILE__))
  if File.exist?(flutter_plugins_deps)
    require 'json'
    deps = JSON.parse(File.read(flutter_plugins_deps))
    tvos_plugins = deps.dig('plugins', 'tvos') || []
    if tvos_plugins.empty?
      raise 'diapason: no tvos plugins to install, and the restore above did ' \
            'not put any back. A Runner built from this has no local storage ' \
            'and cannot keep a signed-in session. Check that python3 is on ' \
            'PATH and that flutter pub get has fetched the tvos packages.'
    end
    tvos_plugins.each do |plugin|
      plugin_name = plugin['name']
      plugin_path = plugin['path']
      tvos_dir = File.join(plugin_path, 'tvos')
      if File.directory?(tvos_dir) && File.exist?(File.join(tvos_dir, "#{plugin_name}.podspec"))
        pod plugin_name, :path => tvos_dir
      end
    end
  end
end

# Diapason's root pubspec is shared across every platform target. Anything
# darwin-only and not meant for tvOS (e.g. a future macOS/iOS-only pod) should
# be blocked here rather than trusted to fail loudly.
pre_install do |installer|
  blocked_prefixes = %w[Firebase Google gRPC BoringSSL abseil nanopb leveldb-library GTMSessionFetcher PromisesObjC FBLPromises]
  installer.pod_targets.reject! do |pod|
    blocked_prefixes.any? { |prefix| pod.name.start_with?(prefix) }
  end
  installer.aggregate_targets.each do |aggregate|
    aggregate.pod_targets.reject! do |pod|
      blocked_prefixes.any? { |prefix| pod.name.start_with?(prefix) }
    end
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['TVOS_DEPLOYMENT_TARGET'] = '17.0'
    end
  end
end
